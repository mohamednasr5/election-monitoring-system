<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>نظام إحصاءات الانتخابات - نسخة احترافية متقدمة</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- خطوط Google SheetJS و Chart.js -->
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
  <style>
    body { font-family:'Cairo',Arial; background:linear-gradient(120deg,#10b981 0%,#8b5cf6 50%,#f59e0b 100%);color:#fff;margin:0;}
    .container{max-width:1200px;margin:auto;padding:24px 10px;}
    h1{text-align:center;font-size:2.7rem;font-weight:900;margin-bottom:12px;background:linear-gradient(90deg,#10b981,#f59e0b 60%,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
    .subtitle{text-align:center;color:#fef3c7;font-size:1.2rem;margin-bottom:24px;}
    .status{text-align:center;font-size:1.1rem;padding:8px 28px;background:#f59e0b21;border-radius:18px;border:1px solid #fff2;margin-bottom:20px;}
    .form-row,.cand-row,.stat-cards,.op-buttons{display:grid;gap:12px;}
    .form-row{grid-template-columns:repeat(4,1fr);margin-bottom:18px;}
    .cand-row{grid-template-columns:repeat(5,1fr);}
    .stat-cards{grid-template-columns:repeat(4,1fr);margin-bottom:20px;}
    .card{background:#f59e0b25;border-radius:13px;padding:26px 14px;text-align:center;}
    .card-title{color:#fef3c7;font-size:1.13rem;margin-bottom:9px;}
    input,select {padding:14px 8px;border-radius:8px;border:none;font-size:1.07rem;margin-bottom:7px;width:100%;}
    input:focus,select:focus {box-shadow:0 0 9px #10b981;outline:none;}
    .cand-box {background:#fff2;border-radius:9px;padding:12px;text-align:center;}
    .cand-box label {font-weight:bold;font-size:1.05rem;color:#8b5cf6;}
    .op-buttons {grid-template-columns:repeat(4,1fr);margin-bottom:22px;}
    .btn {padding:12px 21px; border-radius:13px; background:#10b981; color:#fff; border:none; font-weight:900; cursor:pointer; margin-bottom:7px;}
    .btn:hover {background:#f59e0b;}
    table {width:100%;border-collapse:collapse;background:#fff1;color:#8b5cf6;}
    th,td {padding:10px;border-bottom:1px solid #fb9300;text-align:right;}
    th {background:#f59e0b44;font-weight:bold;}
    tr:hover {background:#8b5cf630;}
    @media(max-width:950px){.form-row,.cand-row,.stat-cards,.op-buttons{grid-template-columns:1fr 1fr;}}
    @media(max-width:600px){.form-row,.cand-row,.stat-cards,.op-buttons{grid-template-columns:1fr;}
      .container{padding:8px;}}
  </style>
</head>
<body>
<div class="container">
  <h1>🗳️ نظام إحصاءات الانتخابات</h1>
  <div class="subtitle">واجهة ديناميكية مترابطة بلا حدود مع قاعدة بيانات وتصدير وتحليل متقدم</div>
  <div class="status" id="conn-status">🟢 متصل بقاعدة البيانات</div>

  <!-- اختيار اليوم -->
  <div style="text-align:center;margin-bottom:16px;">
    <label for="day" style="font-weight:bold;">اختيار يوم الإحصائيات:</label>
    <select id="day" style="font-weight:bold;max-width:200px;">
      <option value="all">إجمالي اليومين</option>
      <option value="day1">اليوم الأول</option>
      <option value="day2">اليوم الثاني</option>
    </select>
  </div>

  <div class="stat-cards" id="stat-cards"></div>

  <form id="add-form" autocomplete="off">
    <div class="form-row">
      <div>
        <label>رقم اللجنة (1-60)</label>
        <input name="num" type="number" min="1" max="60" required>
      </div>
      <div>
        <label>إجمالي الأصوات</label>
        <input name="total" type="number" required>
      </div>
      <div>
        <label>🟢 الصحيحة</label>
        <input name="valid" type="number" required>
      </div>
      <div>
        <label>🔴 الباطلة</label>
        <input name="invalid" type="number" required>
      </div>
    </div>
    <div class="cand-row"></div>
    <div style="margin:10px;text-align:left;">
      <label style="margin-left:8px;">اختيار اليوم:</label>
      <select name="add_day">
        <option value="day1">اليوم الأول</option>
        <option value="day2">اليوم الثاني</option>
      </select>
    </div>
    <button type="submit" class="btn">💾 حفظ اللجنة</button>
  </form>

  <div class="op-buttons">
    <button class="btn" id="export-btn">تصدير Excel</button>
    <button class="btn" onclick="window.print()">طباعة النتائج</button>
    <button class="btn" onclick="resetData()">تصفير البيانات</button>
    <button class="btn" onclick="location.reload()">تحديث الصفحة</button>
  </div>

  <div style="margin:30px 0;">
    <canvas id="mainChart" height="260"></canvas>
  </div>

  <table id="cand-table">
    <thead>
      <tr>
        <th>الترتيب</th>
        <th>المرشح</th>
        <th>عدد الأصوات</th>
        <th>النسبة %</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>

  <table style="margin-top:20px;" id="comm-table">
    <thead>
      <tr>
        <th>رقم اللجنة</th>
        <th>الإجمالي</th>
        <th>الصحيحة</th>
        <th>الباطلة</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</div>

<script>
  // بيانات المرشحين بالترتيب
  const candidates = [
    ["1", "ايهاب العمده", "👑"],["2", "محمد العتمانى", "🍞"],["3", "أحمد الحديدى", "🦁"],
    ["4", "عادل الجيار", "🦅"],["5", "احمد محمد محمد سمره", "💣"],["6", "وليد تيسير الامير", "🐊"],
    ["7", "كمال العيسوى", "🌀"],["8", "البدوى جميز", "🐋"],["9", "احمد الريس", "🦂"],
    ["10", "أحمد عوف", "✋"],["11", "حسن الملهاط", "🌿"],["12", "عمرو محمد بحيرى", "🚌"],
    ["13", "السيد طمان", "🔫"],["14", "محمد دندن", "🚁"],["15", "مجدى الأمير", "🖊"]
  ];

  // توليد مرشحين للمدخلات
  document.querySelector('.cand-row').innerHTML =
    candidates.map(([id,name,emj]) =>
      `<div class="cand-box"><label>${id}. ${emj} ${name}</label>
      <input name="cand_${id}" type="number" min="0" value="0"></div>`
    ).join('');

  // ربط وأعداد الفابيس
  const firebaseConfig = {
    apiKey: "AIzaSyARV_6b-JA6FkWE5EwqMZeLUi2D5ZGonDI",
    authDomain: "natiga-16c46.firebaseapp.com",
    databaseURL: "https://natiga-16c46-default-rtdb.firebaseio.com",
    projectId: "natiga-16c46",
    storageBucket: "natiga-16c46.firebasestorage.app",
    messagingSenderId: "213324147570",
    appId: "1:213324147570:web:3eff7ea7eddac2c5eb4beb",
    measurementId: "G-TLBTLKY983"
  };
  firebase.initializeApp(firebaseConfig);
  const db = firebase.database();

  let allCommittees = [];
  function fetchCommittees(){
    db.ref('committees').once('value',snap=>{
      allCommittees = [];
      if(snap.exists()){
        Object.keys(snap.val()).forEach(k=>{
          allCommittees.push({...snap.val()[k],number:parseInt(k)});
        });
      }
      renderAll();
    });
  }
  fetchCommittees();

  document.getElementById('add-form').onsubmit = function(e){
    e.preventDefault();
    const dt = new FormData(e.target);
    const data = {
      number: parseInt(dt.get('num')),
      totalVotes: parseInt(dt.get('total')),
      validVotes: parseInt(dt.get('valid')),
      invalidVotes: parseInt(dt.get('invalid')),
      day: dt.get('add_day'),
      candidates: {}
    };
    candidates.forEach(([id])=>{
      data.candidates[id]=parseInt(dt.get(`cand_${id}`))||0;
    });
    db.ref('committees/'+data.number).set(data,err=>{
      if(err) alert("خطأ في الحفظ!");
      else {
        alert("✅ تم الحفظ بنجاح!");
        fetchCommittees();
        e.target.reset();
      }
    });
  };

  document.getElementById('day').onchange = renderAll;

  function getFilteredCommittees(){
    const val = document.getElementById('day').value;
    if(val==="all") return allCommittees;
    return allCommittees.filter(comm=>comm.day===val);
  }

  function calculateTotals(){
    const filtered = getFilteredCommittees();
    const totals = {
      totalVotes:0,
      validVotes:0,
      invalidVotes:0,
      candidates:{}
    };
    candidates.forEach(([id])=>{totals.candidates[id]=0;});
    filtered.forEach(comm=>{
      totals.totalVotes += comm.totalVotes||0;
      totals.validVotes += comm.validVotes||0;
      totals.invalidVotes += comm.invalidVotes||0;
      Object.keys(comm.candidates||{}).forEach(id=>{
        totals.candidates[id] = (totals.candidates[id]||0) + (comm.candidates[id]||0);
      });
    });
    totals.committeeCount = filtered.length;
    totals.selectedDay = document.getElementById('day').selectedOptions[0].textContent;
    return totals;
  }

  function renderStats(){
    const t = calculateTotals();
    document.getElementById('stat-cards').innerHTML = `
      <div class="card"><div class="card-title">إجمالي الأصوات</div><div class="card-main">${t.totalVotes.toLocaleString()}</div></div>
      <div class="card"><div class="card-title">🟢 الصحيحة</div><div class="card-main">${t.validVotes.toLocaleString()}</div></div>
      <div class="card"><div class="card-title">🔴 الباطلة</div><div class="card-main">${t.invalidVotes.toLocaleString()}</div></div>
      <div class="card"><div class="card-title">عدد اللجان</div><div class="card-main">${t.committeeCount} / 60</div></div>
    `;
  }

  function renderCandidates(){
    const t = calculateTotals();
    let arr = candidates.map(([id,name,emj],idx)=>({
      number:idx+1, name:`${emj} ${name}`, votes:t.candidates[id]||0,
      percentage:(t.validVotes>0)?((t.candidates[id]||0)/t.validVotes*100).toFixed(2):"0.00"
    })).sort((a,b)=>b.votes-a.votes);
    document.querySelector("#cand-table tbody").innerHTML =
      arr.map(item=>`<tr>
        <td>${item.number}</td>
        <td>${item.name}</td>
        <td>${item.votes.toLocaleString()}</td>
        <td>${item.percentage}%</td>
      </tr>`).join('');
    // جدول للجان أيضاً
    const filtered = getFilteredCommittees();
    document.querySelector("#comm-table tbody").innerHTML =
      filtered.map(comm=>
        `<tr>
          <td>${comm.number}</td>
          <td>${comm.totalVotes||0}</td>
          <td style="color:#10b981">${comm.validVotes||0}</td>
          <td style="color:#f59e0b">${comm.invalidVotes||0}</td>
        </tr>`
      ).join('');
  }

  // رسم بياني ديناميكي مرشحين (Chart.js)
  let chartInstance;
  function renderChart(){
    const t = calculateTotals();
    let arr = candidates.map(([id,name,emj],idx)=>({
      number:idx+1,name:`${emj} ${name}`,votes:t.candidates[id]||0
    })).sort((a,b)=>b.votes-a.votes);
    const ctx = document.getElementById('mainChart').getContext('2d');
    if(chartInstance) chartInstance.destroy();
    chartInstance = new Chart(ctx, {
      type:'bar',
      data:{
        labels:arr.map(c=>`${c.number}. ${c.name}`),
        datasets:[{
          label:'عدد الأصوات',
          data:arr.map(c=>c.votes),
          backgroundColor:arr.map((c,i)=>['#10b981','#8b5cf6','#f59e0b','#ec4899','#ef4444','#3b82f6','#06b6d4','#10b981','#8b5cf6','#f59e0b','#ec4899','#3b82f6','#ef4444','#06b6d4','#8b5cf6'][i%15])
        }]
      },
      options:{
        indexAxis:'y',
        responsive:true,
        plugins:{
          legend:{display:false},
          title:{display:true,text:`نتائج ${t.selectedDay}`,color:'#8b5cf6',font:{weight:'bold',size:20}}
        },
        scales:{
          x:{ticks:{color:'#8b5cf6'},grid:{color:"#10b98132"}},
          y:{ticks:{color:'#8b5cf6'},grid:{color:"#f59e0b32"}}
        }
      }
    });
  }

  // تصدير فعلي إلى Excel بالنتائج كلها
  document.getElementById('export-btn').onclick=function(){
    const t = calculateTotals();
    let arr = candidates.map(([id,name,emj],idx)=>({
      number:idx+1, name:`${emj} ${name}`, votes:t.candidates[id]||0,
      percentage:(t.validVotes>0)?((t.candidates[id]||0)/t.validVotes*100).toFixed(2):"0.00"
    }))
    .sort((a,b)=>b.votes-a.votes);
    let filtered = getFilteredCommittees();
    let ws_data = [
      ['تقرير إحصائيات الانتخابات'],
      ['تاريخ التقرير:', new Date().toLocaleString('ar-EG')],
      ['إحصائيات:', t.selectedDay],
      ['إجمالي الأصوات', t.totalVotes],
      ['الأصوات الصحيحة', t.validVotes],
      ['الأصوات الباطلة', t.invalidVotes],
      ['عدد اللجان', t.committeeCount],
      [''],
      ['نتائج المرشحين'],
      ['الترتيب', 'المرشح', 'عدد الأصوات', 'النسبة %'],
      ...arr.map(item=>[item.number,item.name,item.votes,item.percentage]),
      [''],
      ['تفاصيل اللجان'],
      ['رقم اللجنة','إجمالي الأصوات','الصحيحة','الباطلة', ...candidates.map(c=>c[2]+" "+c[1])],
      ...filtered.map(comm=>[
        comm.number,comm.totalVotes,comm.validVotes,comm.invalidVotes,
        ...candidates.map(([id])=>comm.candidates[id]||0)
      ])
    ];
    let ws = XLSX.utils.aoa_to_sheet(ws_data);
    let wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'إحصائيات الانتخابات');
    XLSX.writeFile(wb, `election_stats_${new Date().toISOString().replace(/T.*/,'')}.xlsx`);
  }

  // تصفير كامل للبيانات
  function resetData(){
    if(confirm('هل أنت متأكد لتصفير كامل بيانات اللجان؟')) {
      db.ref('committees').remove(err=>{
        if(err)alert("لم يتم التصفير - خطأ");
        else {
          alert("تم التصفير بنجاح");
          fetchCommittees();
        }
      });
    }
  }

  // عرض كلي
  function renderAll(){
    renderStats();
    renderCandidates();
    renderChart();
  }
</script>
</body>
</html>
